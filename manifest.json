{
  "manifest_version": 3,
  "name": "文档本地导出",
  "description": "支持飞书 docx/wiki、微信公众号文章导出到本地，并可直接复用浏览器里的公众号后台登录态做同号历史批量下载。",
  "version": "0.3.0",
  "default_locale": "zh_CN",
  "icons": {
    "16": "icon/16.png",
    "32": "icon/32.png",
    "48": "icon/48.png",
    "96": "icon/96.png",
    "128": "icon/128.png"
  },
  "permissions": [
    "activeTab",
    "downloads",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.feishu.cn/*",
    "https://*.larksuite.com/*",
    "https://*.larkoffice.com/*",
    "https://mp.weixin.qq.com/*",
    "https://mmbiz.qpic.cn/*",
    "https://mmsns.qpic.cn/*",
    "https://mmbiz.qlogo.cn/*",
    "http://127.0.0.1:17866/*",
    "http://localhost:17866/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "文档本地导出",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.feishu.cn/docx/*",
        "https://*.feishu.cn/wiki/*",
        "https://*.larksuite.com/docx/*",
        "https://*.larksuite.com/wiki/*",
        "https://*.larkoffice.com/docx/*",
        "https://*.larkoffice.com/wiki/*",
        "https://mp.weixin.qq.com/*"
      ],
      "js": [
        "content-scripts/feishu-exporter.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
